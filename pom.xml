<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>jp.machiriku</groupId>
  <artifactId>machiriku</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>war</packaging>

  <name>machiriku Maven Webapp</name>
  <!-- FIXME: 公開するプロジェクトのWebサイトURLが決まったら置き換える。 -->
  <url>http://www.example.com</url>

  <!-- ソースコードの文字コードと、コンパイルに使用するJavaのバージョンをそろえる。 -->
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
  </properties>

  <dependencies>
    <dependency>
        <!-- Web公開ディレクトリ外に置いた.envを読み込むためのライブラリ。 -->
        <groupId>io.github.cdimascio</groupId>
        <artifactId>dotenv-java</artifactId>
        <version>3.2.0</version>
    </dependency>
    <dependency>
        <!-- 自動テストでのみ使用し、実行用のWARには含めない。 -->
        <groupId>junit</groupId>
        <artifactId>junit</artifactId>
        <version>4.13.2</version>
        <scope>test</scope>
    </dependency>
    <dependency>
        <!-- Servlet APIの実装は配置先のTomcatが提供する。 -->
        <groupId>jakarta.servlet</groupId>
        <artifactId>jakarta.servlet-api</artifactId>
        <version>6.0.0</version>
        <scope>provided</scope>
    </dependency>
    <!-- PostgreSQLへJDBCで接続するためのドライバー。 -->
    <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>42.7.14</version>
    </dependency>
    <dependency>
        <!-- LINEの認証APIから返るJSONを解析する。 -->
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>2.19.0</version>
    </dependency>
  </dependencies>

  <build>
    <!-- Tomcatのコンテキスト設定と一致するWAR名・展開先名を使用する。 -->
    <finalName>machiriku</finalName>
    <pluginManagement><!-- Mavenの既定値に依存しないよう、各ビルドプラグインのバージョンを固定する。 -->
      <plugins>
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.1.0</version>
        </plugin>
        <!-- WAR形式の標準ビルドで使用するプラグインを指定する。 -->
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.0.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.8.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>2.22.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-war-plugin</artifactId>
          <version>3.2.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>2.5.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>2.8.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>

# Copy this file to .env in the project root. Save as UTF-8 without BOM.
# Values in .env override OS environment variables. Never commit .env.

# PostgreSQL
MACHIRIKU_DB_URL=jdbc:postgresql://localhost:5432/machiriku
MACHIRIKU_DB_USER=
MACHIRIKU_DB_PASSWORD=

# LINE Login (callback must match the LINE Developers Console)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=http://localhost:8080/machiriku/jp/machiriku/servlet/auth/LineCallback.action

# Optional: enable only in an isolated demonstration environment.
MACHIRIKU_DEMO_LOGIN_ENABLED=false

# このファイルをプロジェクト直下の.envへコピーし、UTF-8（BOMなし）で保存する。
# .envの値はOSの環境変数より優先する。実際の秘密情報を記入した.envはGitへ登録しない。

# PostgreSQLへの接続先・接続ユーザー・パスワード
MACHIRIKU_DB_URL=jdbc:postgresql://localhost:5432/machiriku
MACHIRIKU_DB_USER=
MACHIRIKU_DB_PASSWORD=

# LINEログインの設定。コールバックURLはLINE Developers Consoleの登録値と一致させる。
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=http://localhost:8080/machiriku/jp/machiriku/servlet/auth/LineCallback.action

# 任意のデモ設定。実利用環境と分けた確認用環境でのみ有効にする。
MACHIRIKU_DEMO_LOGIN_ENABLED=false
